PORT=3000
# 留空時使用作業系統暫存目錄；Zeabur 不掛 Volume 即不永久保存
DATA_DIR=
MAX_PDF_MB=15
WORKER_INTERVAL_MS=2000
RESULT_RETENTION_HOURS=24

# 請依 Lark 管理員提供的 SMTP 資料填寫
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@example.com
SMTP_PASSWORD=請填入Lark產生的第三方專用密碼
MAIL_FROM=your-account@example.com
MAIL_REPLY_TO=your-account@example.com
SMTP_MAX_CONNECTIONS=2
